OPENCODE_SERVER_PASSWORD='your-opencode-secret'

# Optional overrides (arguments > these > built-in defaults):
# OPENCODE_HOST=0.0.0.0
# OPENCODE_PORT=9991
# OPENCODE_CORS="http://localhost:4096,https://app.example.com"
# OPENCODE_PRINT_LOGS=true

# Which env file start-opencode-server.sh sources. Set this in the shell or with
# --env-file; setting it here has no effect on the run that reads this file.
# OPENCODE_ENV_FILE=/path/to/.env
