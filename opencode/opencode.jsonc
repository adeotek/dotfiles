{  
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4-flash",
  "lsp": {},
  "default_agent": "build",
  "agent": {
    "build": {
      "description": "Primary build/orchestrator agent. Full tool access. Delegates analysis to @plan and review to @code-review.",
      "mode": "primary",
      "model": "opencode-go/qwen3.7-plus"
    },
    "plan": {
      "mode": "primary",
      // alt: deepseek-v4-pro + reasoningEffort: max
      "model": "opencode-go/glm-5.3",
      "temperature": 0.1
    },
    "general": {
      "mode": "subagent",
      "model": "opencode-go/qwen3.8-flash",
      "temperature": 0.3
    },
    "explore": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "reasoningEffort": "max",
      "temperature": 0.1
    },
    "scout": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0.2
    },
    "compaction": {
      "model": "opencode-go/deepseek-v4-flash",
      "thinking": { "type": "disabled" }
    },
    "summary": {
      "model": "opencode-go/deepseek-v4-flash",
      "thinking": { "type": "disabled" }
    },
    "title": {
      "model": "opencode-go/deepseek-v4-flash",
      "thinking": { "type": "disabled" }
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (LAN)",
      "options": {
        "baseURL": "https://ollama.hl.adeotek.cloud/v1"
      },
      // context = native ctx window from Ollama /api/show; output = ctx/4 (cap 64k)
      "models": {
        "nemotron-3.5-lightning:30b": { "name": "Nemotron 3.5 Lightning 30B (OLL)", "tool_call": true, "limit": { "context": 1048576, "output": 65536 } },
        "qwen3.8:27b": { "name": "Qwen3.8 27B (OLL)", "tool_call": true, "attachment": true, "limit": { "context": 262144, "output": 65536 } },
        "qwen3-coder:30b": { "name": "Qwen3 Coder 30B (OLL)", "tool_call": true, "limit": { "context": 262144, "output": 65536 } },
        "deepseek-r1:32b": { "name": "DeepSeek R1 32B (OLL)", "tool_call": true, "limit": { "context": 131072, "output": 32768 } },
        "gemma4:latest": { "name": "Gemma4 8B (OLL)", "tool_call": true, "attachment": true, "limit": { "context": 131072, "output": 32768 } }
      }
    }
  // // Route LLM traffic through Headroom proxy for context compression
  //   "opencode": { "options": { "baseURL": "http://localhost:8787/v1" } },
  //   "opencode-go": { "options": { "baseURL": "http://localhost:8787/v1" } }
  },
  "server": {
    "port": 9991,
    "hostname": "0.0.0.0",
    "cors": [
      "http://localhost:9991",
      "http://127.0.0.1:9991"
    ]
  }
}
